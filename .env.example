GEMINI_API_KEY=your_api_key_here
# Optional: fallback chains per role (comma-separated, first serves; each model has its own free quota),
# and the main chain's thinking depth for Gemini 3 models ("" = model default).
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# GEMINI_LITE_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_THINKING_LEVEL=low
SEC_USER_AGENT=Your Name your.email@example.com
# Optional: cross-encoder re-ranking (off by default; slow on CPU).
# RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# RERANKER_DEVICE=cuda
